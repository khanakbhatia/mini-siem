# Default: offline demonstration. No traffic leaves the host.
SIEM_INTEL_PROVIDER=local
# Set provider to abuseipdb explicitly and supply a key for public IP lookups only.
ABUSEIPDB_API_KEY=
# Optional bearer token. Required for all API calls when configured.
SIEM_API_TOKEN=
# Optional database path for the API server; ingestion uses --db.
SIEM_DB=data/alerts.db
